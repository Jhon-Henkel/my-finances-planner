# Application Configurations
APP_NAME=Financas_na_Mão
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DEMO_MODE=false
ASSET_URL=/public

# Error Manager Configurations
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Log Configurations
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configurations
DB_CONNECTION=mysql
DB_HOST=192.168.152.51
DB_PORT=3306
DB_DATABASE=my_finances_planner
DB_USERNAME=root
DB_PASSWORD=123

# Docker Compose Variables
DOCKER_COMPOSE_DB_USER=root
DOCKER_COMPOSE_DB_PASS=123
